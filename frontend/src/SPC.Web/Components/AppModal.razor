@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleBackdropClick">
        <div class="modal card @(Wide ? "modal-wide" : null)" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onclick:stopPropagation="true">
            <h2 id="@_titleId" class="modal-title">@Title</h2>
            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="modal-message">@Message</p>
            }
            @if (ChildContent is not null)
            {
                <div class="modal-body">
                    @ChildContent
                </div>
            }

            <div class="modal-actions">
                @if (Actions is not null)
                {
                    @Actions
                }
                else
                {
                    @if (ShowCancel)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="CancelAsync">
                            @CancelText
                        </button>
                    }
                    @if (ShowConfirm)
                    {
                        <button type="button" class="btn @ConfirmButtonClass" disabled="@ConfirmDisabled" @onclick="ConfirmAsync">
                            @ConfirmText
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string ConfirmText { get; set; } = "OK";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public bool ShowConfirm { get; set; } = true;

    [Parameter]
    public bool Wide { get; set; }

    [Parameter]
    public bool IsError { get; set; }

    [Parameter]
    public bool ConfirmDisabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string ConfirmButtonClass => IsError ? "btn-secondary" : "btn-primary";

    private async Task ConfirmAsync() => await OnConfirm.InvokeAsync();

    private async Task CancelAsync() => await OnCancel.InvokeAsync();

    private async Task HandleBackdropClick()
    {
        if (ShowCancel || Actions is not null)
        {
            await CancelAsync();
        }
        else if (ShowConfirm)
        {
            await ConfirmAsync();
        }
    }
}
