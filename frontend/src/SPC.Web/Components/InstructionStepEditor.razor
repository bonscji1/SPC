@using SPC.Core.Models
@using SPC.Core.Services
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="instruction-step @(IsSolo ? "instruction-step-solo" : null)">
    @if (ShowNumber)
    {
        <span class="instruction-step-num">@StepNumber</span>
    }

    <div class="instruction-step-main">
        <div class="editor-toolbar" @ref="_toolbar">
            <button type="button" class="btn btn-secondary editor-toolbar-btn" data-cmd="bold" title="Bold"><strong>B</strong></button>
            <button type="button" class="btn btn-secondary editor-toolbar-btn" data-cmd="italic" title="Italic"><em>I</em></button>
            <button type="button" class="btn btn-secondary editor-toolbar-btn" data-cmd="bulletList" title="Bullet list">• List</button>
        </div>

        <div @ref="_host" class="rich-editor-host"></div>
    </div>

    @if (CanRemove)
    {
        <button type="button"
                class="btn btn-icon"
                title="Remove step"
                @onclick="AskRemoveAsync">
            ✕
        </button>
    }
</div>

<AppModal IsOpen="_confirmOpen"
          Title="Remove this step?"
          Message="This step has text or linked ingredients. Remove it?"
          ConfirmText="Remove"
          CancelText="Keep"
          ShowCancel="true"
          OnConfirm="ConfirmRemoveAsync"
          OnCancel="CancelRemove" />

@code {
    private ElementReference _host;
    private ElementReference _toolbar;
    private string? _editorId;
    private DotNetObjectReference<InstructionStepEditor>? _dotnetRef;
    private bool _initialized;
    private bool _initInFlight;
    private bool _disposed;
    private string _mentionSignature = string.Empty;

    [Parameter, EditorRequired]
    public InstructionStepDto Step { get; set; } = null!;

    [Parameter, EditorRequired]
    public RecipeDto Recipe { get; set; } = null!;

    [Parameter]
    public int StepNumber { get; set; } = 1;

    [Parameter]
    public bool ShowNumber { get; set; } = true;

    [Parameter]
    public bool CanRemove { get; set; } = true;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private bool _confirmOpen;

    private bool IsSolo => !ShowNumber && !CanRemove;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        if (!_initialized)
        {
            await TryInitEditorAsync();
            return;
        }

        await UpdateMentionsIfNeededAsync();
    }

    private async Task TryInitEditorAsync()
    {
        if (_initInFlight || _initialized || _disposed || string.IsNullOrEmpty(_host.Id))
        {
            return;
        }

        _initInFlight = true;
        try
        {
            await Js.InvokeVoidAsync("spc.loadInstructionEditor");
            if (_disposed || string.IsNullOrEmpty(_host.Id))
            {
                return;
            }

            _dotnetRef = DotNetObjectReference.Create(this);
            var content = InstructionEditor.SerializeStepToTiptap(Step, Recipe);
            var mentions = InstructionEditor.MentionItemsForRecipe(Recipe);
            _mentionSignature = MentionSignature(Recipe);
            _editorId = await Js.InvokeAsync<string>(
                "spcInstructionEditor.init",
                _host,
                _toolbar,
                content,
                mentions,
                _dotnetRef);

            if (_disposed)
            {
                if (_editorId is not null)
                {
                    await Js.InvokeVoidAsync("spcInstructionEditor.destroy", _editorId);
                    _editorId = null;
                }

                return;
            }

            _initialized = true;
        }
        catch (JSException)
        {
            if (_disposed)
            {
                return;
            }

            throw;
        }
        finally
        {
            _initInFlight = false;
        }
    }

    private async Task UpdateMentionsIfNeededAsync()
    {
        if (_disposed || _editorId is null)
        {
            return;
        }

        var currentMentions = InstructionEditor.MentionItemsForRecipe(Recipe);
        var signature = MentionSignature(Recipe);
        if (signature != _mentionSignature)
        {
            _mentionSignature = signature;
            await Js.InvokeVoidAsync("spcInstructionEditor.updateMentions", _editorId, currentMentions);
        }
    }

    [JSInvokable]
    public async Task OnEditorChange(string json)
    {
        InstructionEditor.ApplyTiptapJson(Step, json);
        await OnChanged.InvokeAsync();
    }

    private async Task AskRemoveAsync()
    {
        if (!InstructionEditor.StepHasContent(Step))
        {
            await OnRemove.InvokeAsync();
            return;
        }

        _confirmOpen = true;
    }

    private async Task ConfirmRemoveAsync()
    {
        _confirmOpen = false;
        await OnRemove.InvokeAsync();
    }

    private void CancelRemove() => _confirmOpen = false;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_editorId is not null)
        {
            try
            {
                await Js.InvokeVoidAsync("spcInstructionEditor.destroy", _editorId);
            }
            catch (JSException)
            {
            }
        }

        _dotnetRef?.Dispose();
    }

    private static string MentionSignature(RecipeDto recipe) =>
        string.Join(
            '|',
            recipe.Ingredients.Select(i => $"{i.Id}:{i.Name}:{i.Grams}")
                .Concat(recipe.Spices.Select(s => $"{s.Id}:{s.Name}:{s.Grams}")));
}
