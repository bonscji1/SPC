@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using SPC.Core.Auth
@inject IAuthService Auth
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>Log in — Smart Pig's Cookbook</PageTitle>

<div class="page-header">
    <h1>Log in</h1>
    <p class="muted">Sign in to open your cookbook, library, and profiles.</p>
</div>

<section class="card login-panel">
    <h2 class="section-title">Account</h2>
    <p class="section-hint muted">Use the username and password you signed up with.</p>

    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="field">
            <label for="login-username">Username</label>
            <input id="login-username"
                   class="input"
                   autocomplete="username"
                   @bind="_username" />
        </div>
        <div class="field">
            <label for="login-password">Password</label>
            <input id="login-password"
                   class="input"
                   type="password"
                   autocomplete="current-password"
                   @bind="_password" />
        </div>

        @if (_error is not null)
        {
            <div class="validation-errors" role="alert">
                <p class="validation-title">@_error</p>
            </div>
        }

        <div class="login-actions">
            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @(_busy ? "Signing in…" : "Log in")
            </button>
        </div>
    </form>

    <p class="login-switch muted">
        Need an account? <a href="signup">Sign up</a>
    </p>
</section>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo(SafeReturnUrl());
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var ok = await Auth.LoginAsync(_username, _password);
            if (!ok)
            {
                _error = "Could not sign in. Check the username and password.";
                return;
            }

            Navigation.NavigateTo(SafeReturnUrl());
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach the server. Is the API running?";
        }
        finally
        {
            _busy = false;
        }
    }

    private string SafeReturnUrl()
    {
        var url = ReturnUrl?.Trim();
        if (string.IsNullOrEmpty(url)
            || url.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("signup", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("//", StringComparison.Ordinal)
            || url.Contains('\\'))
        {
            return "";
        }

        return url;
    }
}
