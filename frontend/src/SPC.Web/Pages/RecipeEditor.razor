@page "/recipe/new"
@page "/recipe/{RecipeId:guid}"
@using System.Globalization
@using SPC.Core.Formatting
@using SPC.Core.Models
@using SPC.Core.Repositories
@using SPC.Core.Services
@using SPC.Core.Validation
@implements IAsyncDisposable
@inject RecipeDraftService Draft
@inject IRecipeRepository RecipeRepository
@inject IEnergyCalculator Energy
@inject ActiveProfileService ActiveProfiles
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IIngredientRepository IngredientRepository

<PageTitle>@PageTitle — Smart Pig's Cookbook</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<AppModal IsOpen="_showSaveModal"
          Title="@_saveModalTitle"
          Message="@_saveModalMessage"
          IsError="@_saveModalIsError"
          ConfirmText="OK"
          OnConfirm="CloseSaveModal" />

<AppModal IsOpen="_showLeaveModal"
          Title="Discard unsaved changes?"
          Message="You have changes that are not saved. Leave without saving?"
          ConfirmText="Discard and leave"
          CancelText="Stay on page"
          ShowCancel="true"
          OnConfirm="ConfirmLeave"
          OnCancel="CancelLeave" />

<AppModal IsOpen="_showVariantEditModal"
          Title="Edit variant"
          ShowCancel="true"
          OnCancel="CancelVariantEdit">
    <ChildContent>
        <div class="field">
            <label for="variant-edit-name">Variant name</label>
            <input id="variant-edit-name"
                   class="input"
                   placeholder="Default"
                   value="@_variantEditName"
                   @oninput="e => _variantEditName = e.Value?.ToString() ?? string.Empty" />
            <p class="field-hint muted">Empty or Default is the base tab for this recipe.</p>
        </div>
        @if (!string.IsNullOrEmpty(_variantEditError))
        {
            <div class="validation-errors" role="alert">
                <p>@_variantEditError</p>
            </div>
        }
    </ChildContent>
    <Actions>
        <button type="button" class="btn btn-secondary" @onclick="CancelVariantEdit">Cancel</button>
        <button type="button" class="btn btn-secondary" disabled="@_isSavingVariantEdit" @onclick="AskDeleteEditingVariant">Delete</button>
        <button type="button" class="btn btn-primary" disabled="@_isSavingVariantEdit" @onclick="SaveVariantNameAsync">Save</button>
    </Actions>
</AppModal>

<AppModal IsOpen="_showSaveAsVariantModal"
          Title="Save as variant"
          ConfirmText="Save variant"
          CancelText="Cancel"
          ShowCancel="true"
          ConfirmDisabled="@(_isSavingAsVariant || RecipeDto.IsUnnamedVariant(_saveAsVariantName))"
          OnConfirm="SaveAsVariantAsync"
          OnCancel="CancelSaveAsVariant">
    <p class="section-hint muted">Saves a copy as a new tab. This variant stays as last saved.</p>
    <div class="field">
        <label for="save-as-variant-name">Variant name</label>
        <input id="save-as-variant-name"
               class="input"
               placeholder="e.g. extra onion, half batch"
               value="@_saveAsVariantName"
               @oninput="e => _saveAsVariantName = e.Value?.ToString() ?? string.Empty" />
        <p class="field-hint muted">Shown as a tab on this recipe. Not Default.</p>
    </div>
    @if (!string.IsNullOrEmpty(_saveAsVariantError))
    {
        <div class="validation-errors" role="alert">
            <p>@_saveAsVariantError</p>
        </div>
    }
</AppModal>

<AppModal IsOpen="_showDeleteModal"
          Title="@_deleteTitle"
          Message="@_deleteMessage"
          ConfirmText="Delete"
          CancelText="Cancel"
          ShowCancel="true"
          OnConfirm="ConfirmDeleteAsync"
          OnCancel="CancelDelete" />

<AppModal IsOpen="_showLibraryModal"
          Title="Update ingredient library?"
          Message="@_libraryModalMessage"
          ConfirmText="Update library"
          CancelText="Keep library"
          ShowCancel="true"
          OnConfirm="ConfirmLibraryUpdatesAsync"
          OnCancel="CancelLibraryUpdates" />

<AppModal IsOpen="_showScaleModal"
          Title="Scale this for…"
          ConfirmText="Preview"
          CancelText="Cancel"
          ShowCancel="true"
          ConfirmDisabled="@(!CanPreviewScale)"
          OnConfirm="PreviewScale"
          OnCancel="CancelScale">
    <p class="section-hint muted">Uses theoretical (raw) ingredient grams. Cooked weight is not scaled. Nothing is saved until you choose to.</p>
    <div class="field">
        <label for="scale-portions">Number of portions</label>
        <input id="scale-portions"
               class="input"
               type="number"
               min="0"
               step="0.1"
               placeholder="e.g. 8"
               value="@FormatOptionalDecimal(_scalePortions)"
               @oninput="OnScalePortionsInput" />
    </div>
    <fieldset class="field">
        <legend>Portion size</legend>
        <div class="choice-row">
            <label class="choice">
                <input type="radio"
                       name="scale-size-kind"
                       checked="@(_scaleSizeKind == RecipeScaleSizeKind.GramsPerPortion)"
                       @onchange="@(() => _scaleSizeKind = RecipeScaleSizeKind.GramsPerPortion)" />
                Grams
            </label>
            <label class="choice">
                <input type="radio"
                       name="scale-size-kind"
                       checked="@(_scaleSizeKind == RecipeScaleSizeKind.CaloriesPerPortion)"
                       @onchange="@(() => _scaleSizeKind = RecipeScaleSizeKind.CaloriesPerPortion)" />
                kcal
            </label>
        </div>
    </fieldset>
    <div class="field">
        <label for="scale-size">@(_scaleSizeKind == RecipeScaleSizeKind.GramsPerPortion ? "Grams per portion" : "kcal per portion")</label>
        <input id="scale-size"
               class="input"
               type="number"
               min="0"
               step="0.1"
               placeholder="@(_scaleSizeKind == RecipeScaleSizeKind.GramsPerPortion ? "e.g. 250" : "e.g. 500")"
               value="@FormatOptionalDecimal(_scaleSize)"
               @oninput="OnScaleSizeInput" />
    </div>
    <div class="field">
        <button type="button"
                class="btn btn-secondary"
                disabled="@(MealTargetKcal is null)"
                @onclick="ScaleForProfile">
            @ScaleForProfileLabel
        </button>
        @if (MealTargetKcal is decimal mealKcal)
        {
            <p class="field-hint muted">
                Fills kcal per portion from
                @(string.IsNullOrWhiteSpace(ActiveProfiles.Active?.Name) ? "this profile" : ActiveProfiles.Active!.Name)’s
                @MealTypes.DisplayName(Draft.Recipe.MealType).ToLowerInvariant()
                (@NumberFormat.Format(mealKcal) kcal). Number of portions stays yours (defaults to 1 if empty).
            </p>
        }
        else
        {
            <p class="field-hint muted">Select a profile (top right) to fill kcal from that meal split.</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(_scaleError))
    {
        <div class="validation-errors" role="alert">
            <p>@_scaleError</p>
        </div>
    }
</AppModal>

<AppModal IsOpen="_showScalePreview"
          Title="Scaled ingredients"
          Wide="true"
          ShowCancel="true"
          OnCancel="CancelScale">
    <ChildContent>
    @if (_scalePreview?.Recipe is { } preview)
    {
        <p class="section-hint muted">
            Scale factor @NumberFormat.Format(_scalePreview.ScaleFactor).
            Batch @NumberFormat.WithUnit(_scalePreview.TheoreticalWeightG, "g"),
            @NumberFormat.WithUnit(_scalePreview.TheoreticalCalories, "kcal").
            Not saved yet.
        </p>
        <ul class="scale-preview-list">
            @foreach (var ingredient in preview.Ingredients)
            {
                <li>
                    <span>@ingredient.Name</span>
                    <span>@NumberFormat.WithUnit(ingredient.Grams, "g")</span>
                </li>
            }
            @foreach (var spice in preview.Spices.Where(RecipeValidator.IsSpiceRowTouched))
            {
                <li>
                    <span>@spice.Name</span>
                    <span>@(spice.Grams is > 0 ? NumberFormat.WithUnit(spice.Grams.Value, "g") : "—")</span>
                </li>
            }
        </ul>
        <div class="field">
            <label for="scale-save-name">Name</label>
            <input id="scale-save-name"
                   class="input"
                   placeholder="e.g. extra onion, half batch"
                   value="@_scaleSaveName"
                   @oninput="e => _scaleSaveName = e.Value?.ToString() ?? string.Empty" />
            <p class="field-hint muted">Save as variant uses this as the tab name. Save as recipe uses it as the dish name.</p>
        </div>
        @if (!string.IsNullOrEmpty(_scaleSaveError))
        {
            <div class="validation-errors" role="alert">
                <p>@_scaleSaveError</p>
            </div>
        }
    }
    </ChildContent>
    <Actions>
        <button type="button" class="btn btn-secondary" @onclick="CancelScale">Cancel</button>
        <button type="button" class="btn btn-secondary" disabled="@_isSavingScale" @onclick="SaveScaleAsVariantAsync">Save as variant</button>
        <button type="button" class="btn btn-primary" disabled="@_isSavingScale" @onclick="SaveScaleAsNewAsync">Save as recipe</button>
    </Actions>
</AppModal>

<div class="page-header">
    <h1>@PageHeading</h1>
    @if (ShowVariantTabs)
    {
        <div class="variant-tabs" role="tablist" aria-label="Recipe variants">
            @foreach (var member in _familyMembers)
            {
                var isActive = member.Id == Draft.Recipe.Id;
                <div class="variant-tab-item @(isActive ? "is-active" : null)">
                    <button type="button"
                            role="tab"
                            class="variant-tab"
                            aria-selected="@isActive"
                            @onclick="@(() => SwitchVariant(member.Id))">
                        @member.DisplayVariantLabel()
                    </button>
                    <button type="button"
                            class="variant-tab-edit"
                            title="Edit variant"
                            aria-label="@($"Edit {member.DisplayVariantLabel()}")"
                            @onclick="@(() => OpenVariantEdit(member))">
                        ✎
                    </button>
                </div>
            }
        </div>
    }
    <p class="muted">Name your dish, list ingredients, and write the cooking steps.</p>
</div>

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="validation-errors" role="alert">
        <p class="validation-title">@_loadError</p>
    </div>
}
else
{
    <div class="recipe-layout">
        <section class="card editor-card">
            <section class="editor-section">
                <h2 class="section-title">General</h2>
                <p class="section-hint muted">Name of the dish and which meal it is for.</p>
                <div class="field">
                    <label for="recipe-name">Recipe name</label>
                    <input id="recipe-name"
                           class="input input-lg"
                           placeholder="e.g. Vegetable stew"
                           value="@Draft.Recipe.Name"
                           @oninput="OnRecipeNameInput" />
                </div>
                <div class="field">
                    <label for="recipe-meal-type">Recipe type</label>
                    <select id="recipe-meal-type"
                            class="input"
                            value="@Draft.Recipe.MealType"
                            @onchange="OnMealTypeChanged">
                        @foreach (var meal in MealTypes.All)
                        {
                            <option value="@meal">@MealTypes.DisplayName(meal)</option>
                        }
                    </select>
                    <p class="field-hint muted">Matches the selected profile’s meal split for a calorie suggestion.</p>
                </div>
            </section>

            <section class="editor-section">
                <h2 class="section-title">Ingredients</h2>
                <p class="section-hint muted">Grams and kcal per 100 g are required. Pick a name from the library to fill kcal.</p>

                <div class="recipe-item-list">
                    @foreach (var ingredient in Draft.Recipe.Ingredients)
                    {
                        <RecipeItemRow RowId="ingredient.Id"
                                       Name="@ingredient.Name"
                                       Grams="@ingredient.Grams"
                                       CaloriesPer100g="@ingredient.CaloriesPer100g"
                                       CanRemove="Draft.Recipe.Ingredients.Count > 1"
                                       OccupiedNames="@OccupiedIngredientNames(ingredient.Id)"
                                       OnChanged="@(change => UpdateIngredient(ingredient, change))"
                                       OnRemove="@(() => RemoveIngredient(ingredient.Id))" />
                    }
                </div>

                <div class="section-footer">
                    <button type="button" class="btn btn-secondary" @onclick="AddIngredient">
                        + Add ingredient
                    </button>
                </div>
            </section>

            <section class="editor-section">
                <h2 class="section-title">Spices</h2>
                <p class="section-hint muted">Optional. Name only is fine — grams and kcal can be left blank. Pick from the library when kcal is known.</p>

                @if (Draft.Recipe.Spices.Count == 0)
                {
                    <p class="muted empty-hint">No spices added.</p>
                }
                else
                {
                    <div class="recipe-item-list">
                        @foreach (var spice in Draft.Recipe.Spices)
                        {
                            <RecipeItemRow RowId="spice.Id"
                                           Name="@spice.Name"
                                           Grams="@spice.Grams"
                                           CaloriesPer100g="@spice.CaloriesPer100g"
                                           NameLabel="Spice"
                                           NamePlaceholder="e.g. salt"
                                           GramsLabel="Grams (optional)"
                                           GramsPlaceholder="—"
                                           CaloriesLabel="kcal / 100 g (optional)"
                                           CaloriesPlaceholder="—"
                                           RemoveTitle="Remove spice"
                                           RemoveConfirmTitle="Remove this spice?"
                                           RemoveConfirmMessage="This spice has data. Remove it?"
                                           CanRemove="true"
                                           OccupiedNames="@OccupiedSpiceNames(spice.Id)"
                                           OnChanged="@(change => UpdateSpice(spice, change))"
                                           OnRemove="@(() => RemoveSpice(spice.Id))" />
                        }
                    </div>
                }

                <div class="section-footer">
                    <button type="button" class="btn btn-secondary" @onclick="AddSpice">
                        + Add spice
                    </button>
                </div>
            </section>
        </section>

        <div class="summary-column">
            <RecipeSummary Recipe="Draft.Recipe"
                           HasUnsavedChanges="Draft.HasUnsavedChanges"
                           TargetKind="Draft.PortionTargetKind"
                           TargetValue="Draft.PortionTargetValue"
                           ProfileName="@ActiveProfiles.Active?.Name"
                           MealTargetKcal="@MealTargetKcal"
                           MealTargetTooltip="@MealTargetTooltip"
                           OnUseMealTarget="UseMealTarget"
                           OnActualDishWeightGChanged="OnActualWeightChanged"
                           OnCaloriesPerPortionChanged="OnKcalPerPortionChanged"
                           OnPortionsChanged="OnPortionsChanged"
                           OnGramsPerPortionChanged="OnGramsPerPortionChanged" />

            <div class="save-panel">
                <button type="button"
                        class="btn btn-secondary btn-block"
                        disabled="@(!CanSave || _isSaving || _isDeleting || _isSavingScale || _isSavingAsVariant)"
                        @onclick="OpenScale">
                    Scale this for…
                </button>
                <button type="button"
                        class="btn btn-primary btn-block"
                        disabled="@(!CanSave || _isSaving || _isDeleting || _isSavingAsVariant)"
                        @onclick="SaveRecipeAsync">
                    @(_isSaving ? "Saving…" : "Save recipe")
                </button>
                @if (RecipeId.HasValue && string.IsNullOrEmpty(_loadError))
                {
                    <button type="button"
                            class="btn btn-secondary btn-block"
                            disabled="@(!CanSave || _isSaving || _isDeleting || _isSavingAsVariant)"
                            @onclick="OpenSaveAsVariant">
                        @(_isSavingAsVariant ? "Saving…" : "Save as variant")
                    </button>
                }
            </div>
        </div>
    </div>

    <section class="card editor-instructions-card">
        <h2 class="section-title">Instructions</h2>
        <p class="section-hint muted">Ordered steps. Type <code>#</code> to link an ingredient or spice — hover the chip for the amount.</p>

        @if (Draft.Recipe.Instructions.Count == 0)
        {
            <p class="muted empty-hint">No steps yet.</p>
        }
        else
        {
            <div class="instruction-list">
                @for (var i = 0; i < Draft.Recipe.Instructions.Count; i++)
                {
                    var step = Draft.Recipe.Instructions[i];
                    var number = i + 1;
                    <InstructionStepEditor @key="step.Id"
                                           Step="step"
                                           Recipe="Draft.Recipe"
                                           StepNumber="number"
                                           OnChanged="OnRecipeChanged"
                                           OnRemove="@(() => RemoveInstruction(step.Id))" />
                }
            </div>
        }

        <div class="section-footer">
            <button type="button" class="btn btn-secondary" @onclick="AddInstruction">
                + Add step
            </button>
        </div>
    </section>

    <section class="card editor-instructions-card">
        <h2 class="section-title">Notes</h2>
        <p class="section-hint muted">What you think about this variant. Type <code>#</code> to link an ingredient or spice — hover the chip for the amount.</p>
        @if (DraftReadyForEditors)
        {
            <InstructionStepEditor @key="@($"notes-{Draft.Recipe.Id}")"
                                   Step="Draft.Recipe.Notes"
                                   Recipe="Draft.Recipe"
                                   ShowNumber="false"
                                   CanRemove="false"
                                   OnChanged="OnRecipeChanged" />
        }
    </section>
}

@code {
    [Parameter]
    public Guid? RecipeId { get; set; }

    private string? _loadError;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _showSaveModal;
    private bool _saveModalIsError;
    private string _saveModalTitle = string.Empty;
    private string _saveModalMessage = string.Empty;
    private bool _showLeaveModal;
    private bool _showDeleteModal;
    private bool _showLibraryModal;
    private string _libraryModalMessage = string.Empty;
    private IReadOnlyList<IngredientLibraryUpdate> _pendingLibraryUpdates = [];
    private string _deleteTitle = "Delete this recipe?";
    private string _deleteMessage = "This recipe has data. Delete it? This cannot be undone.";
    private Guid? _pendingDeleteId;
    private string? _pendingNavigation;
    private bool _bypassNavigationGuard;

    private bool _newInitialized;
    private Guid? _loadedRouteId;
    private bool _showScaleModal;
    private bool _showScalePreview;
    private bool _isSavingScale;
    private decimal? _scalePortions;
    private decimal? _scaleSize;
    private RecipeScaleSizeKind _scaleSizeKind = RecipeScaleSizeKind.GramsPerPortion;
    private string? _scaleError;
    private string? _scaleSaveError;
    private RecipeScaleResult? _scalePreview;
    private string _scaleSaveName = string.Empty;
    private IReadOnlyList<RecipeDto> _familyMembers = [];
    private bool _showVariantEditModal;
    private bool _isSavingVariantEdit;
    private Guid? _editingVariantId;
    private string _variantEditName = string.Empty;
    private string? _variantEditError;
    private bool _showSaveAsVariantModal;
    private bool _isSavingAsVariant;
    private string _saveAsVariantName = string.Empty;
    private string? _saveAsVariantError;

    private string PageHeading => RecipeId.HasValue ? "Edit recipe" : "Create recipe";

    private string PageTitle => string.IsNullOrWhiteSpace(Draft.Recipe.Name) ? PageHeading : Draft.Recipe.DisplayTitle();

    private bool ShowVariantTabs => RecipeId.HasValue && string.IsNullOrEmpty(_loadError) && _familyMembers.Count > 0;

    private bool DraftReadyForEditors =>
        string.IsNullOrEmpty(_loadError)
        && (RecipeId is Guid id ? _loadedRouteId == id : _newInitialized);

    private bool CanSave => RecipeValidator.IsRecipeValid(Draft.Recipe);

    private EnergyEstimateDto? ActiveEnergy
    {
        get
        {
            var profile = ActiveProfiles.Active;
            if (profile is null || !ProfileValidator.IsProfileValid(profile))
            {
                return null;
            }

            return Energy.Estimate(profile);
        }
    }

    private decimal? MealTargetKcal => ActiveEnergy?.KcalFor(Draft.Recipe.MealType);

    private string ScaleForProfileLabel
    {
        get
        {
            var name = ActiveProfiles.Active?.Name?.Trim();
            return string.IsNullOrWhiteSpace(name) ? "Scale for profile" : $"Scale for profile {name}";
        }
    }

    private string? MealTargetTooltip
    {
        get
        {
            var estimate = ActiveEnergy;
            var profile = ActiveProfiles.Active;
            if (estimate is null || profile is null)
            {
                return null;
            }

            var meal = Draft.Recipe.MealType;
            var mealName = MealTypes.DisplayName(meal).ToLowerInvariant();
            var split = profile.MealSplit.PercentFor(meal) / 100m;
            return $"Caloric value of {mealName} to maintain weight. Formula: maintenance [{NumberFormat.Format(estimate.TdeeKcal)}] × {mealName} meal split [{FormatFactor(split)}].";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ActiveProfiles.Changed += OnActiveProfileChanged;
        await ActiveProfiles.InitializeAsync();
    }

    private void OnActiveProfileChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        if (RecipeId is Guid id)
        {
            if (_loadedRouteId == id)
            {
                return;
            }

            _loadedRouteId = id;
            _newInitialized = false;

            var recipe = await RecipeRepository.GetByIdAsync(id);
            if (recipe is null)
            {
                _loadError = "Recipe not found.";
                _familyMembers = [];
                await SyncBeforeUnloadAsync();
                return;
            }

            Draft.Load(recipe);
            _familyMembers = await RecipeRepository.GetByFamilyIdAsync(RecipeScaler.FamilyKey(recipe));
            _loadError = null;
            await SyncBeforeUnloadAsync();
            return;
        }

        if (_newInitialized)
        {
            return;
        }

        _newInitialized = true;
        _loadedRouteId = null;
        _loadError = null;
        _familyMembers = [];
        Draft.NewRecipe();
        Draft.AddIngredient();
        Draft.MarkClean();
        await SyncBeforeUnloadAsync();
    }

    private void OnRecipeNameInput(ChangeEventArgs e)
    {
        Draft.Recipe.Name = e.Value?.ToString() ?? string.Empty;
        OnRecipeChanged();
    }

    private void SwitchVariant(Guid id)
    {
        if (id == Draft.Recipe.Id)
        {
            return;
        }

        Navigation.NavigateTo($"/recipe/{id}");
    }

    private void OpenVariantEdit(RecipeDto member)
    {
        _editingVariantId = member.Id;
        _variantEditName = member.DisplayVariantLabel();
        _variantEditError = null;
        _showVariantEditModal = true;
    }

    private void CancelVariantEdit()
    {
        _showVariantEditModal = false;
        _editingVariantId = null;
        _variantEditError = null;
    }

    private async Task SaveVariantNameAsync()
    {
        if (_editingVariantId is not Guid id)
        {
            return;
        }

        var normalized = RecipeDto.NormalizeVariantLabel(_variantEditName);
        if (RecipeList.VariantLabelIsTaken(_familyMembers, id, normalized))
        {
            _variantEditError = "That name is already used on another tab.";
            return;
        }

        var stored = await RecipeRepository.GetByIdAsync(id);
        if (stored is null)
        {
            _variantEditError = "This variant is no longer saved.";
            return;
        }

        if (RecipeDto.NormalizeVariantLabel(stored.VariantLabel) == normalized)
        {
            CancelVariantEdit();
            return;
        }

        stored.VariantLabel = normalized;
        _isSavingVariantEdit = true;
        try
        {
            var result = await RecipeRepository.SaveAsync(stored);
            if (!result.Success)
            {
                _variantEditError = result.Message;
                return;
            }

            if (Draft.Recipe.Id == id)
            {
                Draft.ApplyPersistedVariantLabel(normalized);
                await SyncBeforeUnloadAsync();
            }

            _familyMembers = await RecipeRepository.GetByFamilyIdAsync(RecipeScaler.FamilyKey(stored));
            CancelVariantEdit();
        }
        finally
        {
            _isSavingVariantEdit = false;
        }
    }

    private void AskDeleteEditingVariant()
    {
        if (_editingVariantId is not Guid id)
        {
            return;
        }

        var member = _familyMembers.FirstOrDefault(m => m.Id == id) ?? Draft.Recipe;
        CancelVariantEdit();
        AskDelete(member);
    }

    private void OpenSaveAsVariant()
    {
        _saveAsVariantName = string.Empty;
        _saveAsVariantError = null;
        _showSaveAsVariantModal = true;
    }

    private void CancelSaveAsVariant()
    {
        _showSaveAsVariantModal = false;
        _saveAsVariantError = null;
    }

    private async Task SaveAsVariantAsync()
    {
        if (RecipeDto.IsUnnamedVariant(_saveAsVariantName))
        {
            _saveAsVariantError = "Add a name other than Default for this variant.";
            return;
        }

        var label = RecipeDto.NormalizeVariantLabel(_saveAsVariantName);
        if (RecipeList.VariantLabelIsTaken(_familyMembers, Guid.Empty, label))
        {
            _saveAsVariantError = "That name is already used on another tab.";
            return;
        }

        var familyId = RecipeScaler.FamilyKey(Draft.Recipe);
        var toSave = RecipeScaler.AsVariant(Draft.Recipe, familyId, label);
        toSave.Name = string.IsNullOrWhiteSpace(Draft.Recipe.Name) ? toSave.Name : Draft.Recipe.Name.Trim();

        if (!RecipeValidator.IsRecipeValid(toSave))
        {
            _saveAsVariantError = RecipeValidator.ValidateRecipe(toSave).FirstOrDefault() ?? "Cannot save this variant.";
            return;
        }

        _isSavingAsVariant = true;
        try
        {
            var result = await RecipeRepository.SaveAsync(toSave);
            if (!result.Success)
            {
                _saveAsVariantError = result.Message;
                return;
            }

            CancelSaveAsVariant();
            _bypassNavigationGuard = true;
            Navigation.NavigateTo($"/recipe/{toSave.Id}");
        }
        finally
        {
            _isSavingAsVariant = false;
        }
    }

    private void OnMealTypeChanged(ChangeEventArgs e)
    {
