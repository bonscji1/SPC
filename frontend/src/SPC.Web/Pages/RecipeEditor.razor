        {
            Draft.Recipe.MealType = meal;
            OnRecipeChanged();
        }
    }

    private void OnRecipeChanged()
    {
        _ = SyncBeforeUnloadAsync();
        StateHasChanged();
    }

    private void OnActualWeightChanged(decimal? grams)
    {
        Draft.Recipe.ActualDishWeightG = grams;
        OnRecipeChanged();
    }

    private void OnKcalPerPortionChanged(decimal? kcal)
