    private async Task SaveRecipeAsync()
    {
        if (!CanSave)
        {
            ShowSaveModal("Cannot save", "Fix validation errors before saving.", isError: true);
            return;
        }

        _isSaving = true;

        try
        {
            var result = await RecipeRepository.SaveAsync(Draft.Recipe);
            if (!result.Success)
            {
                ShowSaveModal("Save failed", result.Message, isError: true);
                return;
            }

            Draft.MarkClean();
            await SyncBeforeUnloadAsync();

            if (!RecipeId.HasValue)
            {
                _bypassNavigationGuard = true;
                Navigation.NavigateTo($"/recipe/{Draft.Recipe.Id}");
            }

            await SyncIngredientLibraryAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SyncIngredientLibraryAsync()
    {
        var library = await IngredientRepository.GetAllAsync();
        var sync = IngredientLibrary.ProposeSync(IngredientLibrary.LinesFrom(Draft.Recipe), library);

        foreach (var add in sync.ToAdd)
        {
            await IngredientRepository.SaveAsync(add);
        }

        if (sync.ToUpdate.Count == 0)
        {
            ShowSaveModal("Saved", "Recipe saved successfully.", isError: false);
            return;
        }

        _pendingLibraryUpdates = sync.ToUpdate;
        _libraryModalMessage = IngredientLibrary.FormatUpdatePrompt(sync.ToUpdate);
        _showLibraryModal = true;
    }

    private async Task ConfirmLibraryUpdatesAsync()
    {
        _showLibraryModal = false;
        foreach (var update in _pendingLibraryUpdates)
        {
            var item = update.Existing.Clone();
            item.CaloriesPer100g = update.NewCaloriesPer100g;
            await IngredientRepository.SaveAsync(item);
        }

        _pendingLibraryUpdates = [];
        ShowSaveModal("Saved", "Recipe and library updated.", isError: false);
    }

    private void CancelLibraryUpdates()
    {
        _showLibraryModal = false;
        _pendingLibraryUpdates = [];
        ShowSaveModal("Saved", "Recipe saved successfully.", isError: false);
    }

    private void AskDelete(RecipeDto recipe)
    {
        _pendingDeleteId = recipe.Id;
        if (_familyMembers.Count > 1)
        {
            _deleteTitle = "Delete this variant?";
            _deleteMessage = $"“{recipe.DisplayTitle()}” will be deleted. Other variants of this recipe stay.";
        }
        else
        {
            _deleteTitle = "Delete this recipe?";
            _deleteMessage = $"“{recipe.DisplayTitle()}” has data. Delete it? This cannot be undone.";
        }

        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _pendingDeleteId = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeleteId is not Guid id)
        {
            _showDeleteModal = false;
            return;
        }

        _showDeleteModal = false;
        _isDeleting = true;
        var deletingCurrent = Draft.Recipe.Id == id;

        try
        {
            var familyId = RecipeScaler.FamilyKey(Draft.Recipe);
            await RecipeRepository.DeleteAsync(id);
            var remaining = await RecipeRepository.GetByFamilyIdAsync(familyId);

            if (!deletingCurrent)
            {
                _familyMembers = remaining;
                _pendingDeleteId = null;
                return;
            }

            _pendingDeleteId = null;
            _bypassNavigationGuard = true;
            Draft.MarkClean();
            await SyncBeforeUnloadAsync();
            Navigation.NavigateTo(remaining.Count == 0 ? "/" : $"/recipe/{remaining[0].Id}");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void ShowSaveModal(string title, string message, bool isError)
    {
        _saveModalTitle = title;
        _saveModalMessage = message;
        _saveModalIsError = isError;
        _showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        _showSaveModal = false;
    }

    private Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (_bypassNavigationGuard || _loadError is not null || !Draft.HasUnsavedChanges)
        {
            return Task.CompletedTask;
        }

        context.PreventNavigation();
        _pendingNavigation = context.TargetLocation;
        _showLeaveModal = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmLeave()
    {
        _showLeaveModal = false;
        _bypassNavigationGuard = true;
        Draft.MarkClean();
        await SyncBeforeUnloadAsync();

        if (!string.IsNullOrEmpty(_pendingNavigation))
        {
            Navigation.NavigateTo(_pendingNavigation);
        }
    }

    private void CancelLeave()
    {
        _showLeaveModal = false;
        _pendingNavigation = null;
    }

    private async Task SyncBeforeUnloadAsync()
    {
        var enabled = _loadError is null && Draft.HasUnsavedChanges;
        await Js.InvokeVoidAsync("spc.setBeforeUnload", enabled);
    }

    public async ValueTask DisposeAsync()
    {
        ActiveProfiles.Changed -= OnActiveProfileChanged;
        await Js.InvokeVoidAsync("spc.setBeforeUnload", false);
    }

    private static string FormatFactor(decimal value) =>
        decimal.Round(value, 2, MidpointRounding.AwayFromZero).ToString("0.0#", CultureInfo.InvariantCulture);

    private bool CanPreviewScale => _scalePortions is > 0 && _scaleSize is > 0;

    private void OpenScale()
    {
        _scaleError = null;
        _scaleSaveError = null;
        _scalePreview = null;
        _showScalePreview = false;
        _scalePortions = Draft.PortionTargetKind == PortionTargetKind.Portions ? Draft.PortionTargetValue : null;
        _scaleSize = null;
        _scaleSizeKind = RecipeScaleSizeKind.GramsPerPortion;
        _showScaleModal = true;
    }

    private void OnScalePortionsInput(ChangeEventArgs e) => _scalePortions = ParseOptionalDecimal(e.Value);

    private void OnScaleSizeInput(ChangeEventArgs e) => _scaleSize = ParseOptionalDecimal(e.Value);

    private void ScaleForProfile()
    {
        if (MealTargetKcal is not decimal kcal)
        {
            return;
        }

        _scaleSizeKind = RecipeScaleSizeKind.CaloriesPerPortion;
        _scaleSize = kcal;
        if (_scalePortions is not > 0)
        {
            _scalePortions = 1;
        }
    }

    private void PreviewScale()
    {
        if (_scalePortions is not > 0 || _scaleSize is not > 0)
        {
            return;
        }

        var result = RecipeScaler.Scale(Draft.Recipe, _scalePortions.Value, _scaleSizeKind, _scaleSize.Value);
        if (!result.Success)
        {
            _scaleError = result.Error;
            return;
        }

        _scaleError = null;
        _scaleSaveError = null;
        _scalePreview = result;
        var baseName = string.IsNullOrWhiteSpace(Draft.Recipe.Name) ? "Recipe" : Draft.Recipe.Name.Trim();
        _scaleSaveName = $"{baseName} (scaled)";
        _showScaleModal = false;
        _showScalePreview = true;
    }

    private void CancelScale()
    {
        _showScaleModal = false;
        _showScalePreview = false;
        _scalePreview = null;
        _scaleError = null;
        _scaleSaveError = null;
    }

    private async Task SaveScaleAsNewAsync()
    {
        if (_scalePreview?.Recipe is null)
        {
            return;
        }

        var name = string.IsNullOrWhiteSpace(_scaleSaveName)
            ? $"{Draft.Recipe.Name.Trim()} (scaled)"
            : _scaleSaveName.Trim();
        var toSave = RecipeScaler.AsNewRecipe(_scalePreview.Recipe, name);
        await PersistScaledAsync(toSave);
    }

    private async Task SaveScaleAsVariantAsync()
    {
        if (_scalePreview?.Recipe is null)
        {
            return;
        }

        if (RecipeDto.IsUnnamedVariant(_scaleSaveName))
        {
            _scaleSaveError = "Add a name other than Default for this variant.";
            return;
        }

        var familyId = RecipeScaler.FamilyKey(Draft.Recipe);
        var toSave = RecipeScaler.AsVariant(_scalePreview.Recipe, familyId, _scaleSaveName);
        toSave.Name = string.IsNullOrWhiteSpace(Draft.Recipe.Name) ? toSave.Name : Draft.Recipe.Name.Trim();
        await PersistScaledAsync(toSave);
    }

    private async Task PersistScaledAsync(RecipeDto toSave)
    {
        if (!RecipeValidator.IsRecipeValid(toSave))
        {
            _scaleSaveError = RecipeValidator.ValidateRecipe(toSave).FirstOrDefault() ?? "Cannot save this scaled recipe.";
            return;
        }

        _isSavingScale = true;
        try
        {
            var result = await RecipeRepository.SaveAsync(toSave);
            if (!result.Success)
            {
                _scaleSaveError = result.Message;
                return;
            }

            CancelScale();
            _bypassNavigationGuard = true;
            Navigation.NavigateTo($"/recipe/{toSave.Id}");
        }
        finally
        {
            _isSavingScale = false;
        }
    }

    private static string FormatOptionalDecimal(decimal? value) => NumberFormat.Format(value);

    private static decimal? ParseOptionalDecimal(object? value)
    {
        var text = value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;
    }
}
