@page "/"
@using SPC.Core.Models
@using SPC.Core.Repositories
@using SPC.Core.Validation
@inject IRecipeRepository RecipeRepository

<PageTitle>Smart Pig's Cookbook</PageTitle>

<AppModal IsOpen="_showDeleteModal"
          Title="Delete this recipe?"
          Message="@_deleteMessage"
          ConfirmText="Delete"
          CancelText="Cancel"
          ShowCancel="true"
          OnConfirm="ConfirmDeleteAsync"
          OnCancel="CancelDelete" />

<section class="hero">
    <h1>Smart Pig's Cookbook</h1>
    <p class="tagline">
        Cook what you love. Know your portions. Skip the tedious calorie math.
    </p>
    <a class="btn btn-primary" href="recipe/new">Create a recipe</a>
</section>

<section class="card saved-recipes-card">
    <h2 class="section-title">Saved recipes</h2>
    <p class="section-hint muted">Open a recipe to keep editing, or delete one you no longer need.</p>

    @if (_isLoading)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        @if (ShowFilters)
        {
            <div class="list-filters">
                <div class="field saved-recipe-filter">
                    <label for="recipe-name-filter">Name</label>
                    <input id="recipe-name-filter"
                           class="input"
                           placeholder="Filter by name"
                           value="@_nameQuery"
                           @oninput="OnNameFilterChanged" />
                </div>
                <div class="field saved-recipe-filter">
                    <label for="recipe-meal-filter">Type</label>
                    <select id="recipe-meal-filter"
                            class="input"
                            value="@MealFilterValue"
                            @onchange="OnMealFilterChanged">
                        <option value="">All types</option>
                        @foreach (var meal in MealTypes.All)
                        {
                            <option value="@meal">@MealTypes.DisplayName(meal)</option>
                        }
                    </select>
                </div>
            </div>
        }

        @if (_page.TotalCount == 0)
        {
            @if (HasActiveFilters)
            {
                <p class="muted">No recipes match those filters.</p>
            }
            else
            {
                <p class="muted">No saved recipes yet. Create one and hit <strong>Save recipe</strong>.</p>
            }
        }
        else
        {
            <ul class="saved-recipe-list">
                @foreach (var recipe in _page.Items)
                {
                    <li class="saved-recipe-row">
                        <a class="saved-recipe-link" href="@($"recipe/{recipe.Id}")">
                            <span class="saved-recipe-name">@recipe.Name</span>
                            <span class="saved-recipe-meta">
                                @MealTypes.DisplayName(recipe.MealType)
                                · @recipe.Ingredients.Count ingredients
                                @if (recipe.Spices.Any(RecipeValidator.IsSpiceRowTouched))
                                {
                                    <text> · @recipe.Spices.Count(RecipeValidator.IsSpiceRowTouched) spices</text>
                                }
                                @if (recipe.UpdatedAt is not null)
                                {
                                    <text> · @recipe.UpdatedAt.Value.ToLocalTime().ToString("g")</text>
                                }
                            </span>
                        </a>
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="() => AskDelete(recipe)">
                            Delete
                        </button>
                    </li>
                }
            </ul>

            <ListPager Page="_page.Page"
                       TotalPages="_page.TotalPages"
                       PageSize="_pageSize"
                       HasPrevious="_page.HasPrevious"
                       HasNext="_page.HasNext"
                       PageSizeChanged="OnPageSizeChanged"
                       Previous="PreviousPageAsync"
                       Next="NextPageAsync" />
        }
    }
</section>

@code {
    private PagedResult<RecipeDto> _page = Paging.Slice(Array.Empty<RecipeDto>(), 1, Paging.DefaultPageSize);
    private int _pageSize = Paging.DefaultPageSize;
    private int _requestedPage = 1;
    private MealType? _mealFilter;
    private string _nameQuery = string.Empty;
    private bool _isLoading = true;
    private bool _showDeleteModal;
    private Guid? _pendingDeleteId;
    private string _deleteMessage = string.Empty;

    private string MealFilterValue => _mealFilter?.ToString() ?? string.Empty;

    private bool HasActiveFilters => _mealFilter is not null || !string.IsNullOrWhiteSpace(_nameQuery);

    private bool ShowFilters => _page.TotalCount > 0 || HasActiveFilters;

    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    private async Task LoadPageAsync()
    {
        _page = await RecipeRepository.GetPageAsync(
            _requestedPage,
            _pageSize,
            _mealFilter,
            string.IsNullOrWhiteSpace(_nameQuery) ? null : _nameQuery);
        _requestedPage = _page.Page;
        _isLoading = false;
    }

    private async Task OnNameFilterChanged(ChangeEventArgs e)
    {
        _nameQuery = e.Value?.ToString() ?? string.Empty;
        _requestedPage = 1;
        await LoadPageAsync();
    }

    private async Task OnMealFilterChanged(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        _mealFilter = string.IsNullOrWhiteSpace(text)
            ? null
            : Enum.TryParse<MealType>(text, out var meal) ? meal : null;
        _requestedPage = 1;
        await LoadPageAsync();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _requestedPage = 1;
        await LoadPageAsync();
    }

    private async Task PreviousPageAsync()
    {
        _requestedPage = _page.Page - 1;
        await LoadPageAsync();
    }

    private async Task NextPageAsync()
    {
        _requestedPage = _page.Page + 1;
        await LoadPageAsync();
    }

    private void AskDelete(RecipeDto recipe)
    {
        _pendingDeleteId = recipe.Id;
        var name = string.IsNullOrWhiteSpace(recipe.Name) ? "this recipe" : recipe.Name.Trim();
        _deleteMessage = $"“{name}” has data. Delete it? This cannot be undone.";
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _pendingDeleteId = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        _showDeleteModal = false;
        if (_pendingDeleteId is not Guid id)
        {
            return;
        }

        _pendingDeleteId = null;
        await RecipeRepository.DeleteAsync(id);
        await LoadPageAsync();
    }
}
